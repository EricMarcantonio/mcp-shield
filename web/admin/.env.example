# Copy to .env.local for local development. Every value here is optional.

# Where the gateway's approval API lives, for `npm run dev`. The dev server
# proxies /api and /healthz there, so the browser stays same-origin and no CORS
# configuration is needed on the gateway.
DEV_GATEWAY_URL=http://localhost:8081

# Baked into the bundle at build time. Leave empty to call the same origin the
# console is served from, which is what a reverse-proxied deployment wants.
# At run time, window.__MCP_SHIELD__.apiBaseUrl (public/config.js, rewritten by
# the Docker entrypoint from $API_BASE_URL) takes precedence over this.
VITE_API_BASE_URL=

# Fixes the name decisions are recorded under, and removes the in-browser
# field. Leave empty to let the operator set their own.
VITE_OPERATOR_NAME=
